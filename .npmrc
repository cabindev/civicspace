# next-auth v4 ประกาศ peerDependencies ของ next ไว้แค่ ^12–^15 ยังไม่รองรับ ^16
# ทำให้ `npm ci` / `npm install` ล้มด้วย ERESOLVE บนเซิร์ฟเวอร์ตอน deploy
# ใช้งานจริงเข้ากันได้ (ทดสอบแล้ว: build ผ่าน, /api/auth/* ตอบ 200, proxy.ts กัน /dashboard ได้)
# เอาบรรทัดนี้ออกได้เมื่อย้ายไป Auth.js v5 ซึ่งรองรับ Next 16 อย่างเป็นทางการ
legacy-peer-deps=true
